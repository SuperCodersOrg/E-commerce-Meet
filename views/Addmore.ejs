<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product - ShopHigh</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-black font-sans antialiased flex flex-col min-h-screen">

    <header class="flex justify-between items-center px-8 py-5 border-b border-black bg-white">
        <div class="text-2xl font-black tracking-wider uppercase">
            <a href="/">ShopHigh</a>
        </div>
        <div>
            <a href="/" class="px-4 py-2 border border-black text-black hover:bg-black hover:text-white transition uppercase text-sm font-semibold">Back to Home</a>
        </div>
    </header>

    <main class="flex-grow max-w-3xl mx-auto px-6 py-10 w-full">
        <h1 class="text-3xl font-black mb-8 uppercase tracking-tight text-center">Add Product</h1>

        <div class="border border-black p-10 bg-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
            <h2 class="text-xl font-black uppercase mb-6 border-b border-black pb-2">Product Details</h2>
            

            <form id="product-form" class="space-y-4" action="/Addmore" method="POST" >
                <div>
                    <label for="productname" class="block text-xs font-bold uppercase mb-1">Name</label>
                    <input type="text" id="productname" name="name" required class="w-full border border-black p-3 text-sm focus:outline-none focus:bg-gray-50" placeholder="Enter product name">
                </div>
                
                <div>
                    <label for="description" class="block text-xs font-bold uppercase mb-1">Description</label>
                    <input type="text" id="description" name="description" required class="w-full border border-black p-3 text-sm focus:outline-none focus:bg-gray-50" placeholder="Enter description">
                </div>

                <div>
                    <label for="price" class="block text-xs font-bold uppercase mb-1">Price (₹)</label>
                  
                    <input type="number" id="price" name="price" required class="w-full border border-black p-3 text-sm focus:outline-none focus:bg-gray-50" placeholder="Enter price">
                </div>

                <div>
                    <label for="category" class="block text-xs font-bold uppercase mb-1">Category</label>
                    <input type="text" id="category" name="category" required class="w-full border border-black p-3 text-sm focus:outline-none focus:bg-gray-50" placeholder="Enter category">
                </div>

                <div>
                    <label for="stock" class="block text-xs font-bold uppercase mb-1">Stock</label>
                  
                    <input type="number" id="stock" name="stock" required class="w-full border border-black p-3 text-sm focus:outline-none focus:bg-gray-50" placeholder="Enter stock count">
                </div>

                <div>
                    <label for="image" class="block text-xs font-bold uppercase mb-1">Product Image</label>
                   
                    <input type="file" id="image" name="image" required class="w-full border border-black p-3 text-sm focus:outline-none focus:bg-gray-50">
                </div>
                
                <button type="submit" class="w-full bg-black text-white py-3 font-bold uppercase text-sm hover:bg-gray-800 transition shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
                    Submit Data
                </button>
            </form>
        </div>
    </main>

    <footer class="text-center py-6 border-t border-black text-sm uppercase font-semibold bg-white mt-auto">
        &copy; 2026 ShopHigh. All Rights Reserved.
    </footer>

</body>
</html>