<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Razorpay Checkout Demo</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Razorpay Checkout SDK Script -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>
<body class="bg-gray-100 p-10 flex justify-center items-center min-h-screen">

  <div class="bg-white border border-black p-8 max-w-md w-full shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] text-center">
    <h1 class="text-2xl font-black uppercase mb-4">Checkout</h1>
    <p class="text-gray-600 mb-6">Total Amount: <span class="font-bold text-black text-xl">₹500</span></p>

    <button id="pay-btn" class="w-full bg-black text-white font-bold py-3 uppercase text-sm hover:bg-gray-800 transition">
      Pay Now
    </button>
  </div>

  <script>
    document.getElementById('pay-btn').onclick = async function (e) {
      e.preventDefault();

      const totalAmount = 500; // Amount in INR

      try {
        // Step 1: Request backend to create Razorpay Order
        const res = await fetch('/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount: totalAmount })
        });
        const orderData = await res.json();

        if (!orderData.success) {
          alert('Failed to initiate order.');
          return;
        }

        // Step 2: Configure Razorpay Checkout Modal
        const options = {
          "key": orderData.key_id, 
          "amount": orderData.amount, 
          "currency": orderData.currency,
          "name": "ShopHigh",
          "description": "Purchase Payment",
          "order_id": orderData.order_id, // Unique Order ID from server
          
          // Handler function called after user completes payment
          "handler": async function (response) {
            // Step 3: Send verification payload to backend
            const verifyRes = await fetch('/verify-payment', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                razorpay_order_id: response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature: response.razorpay_signature
              })
            });

            const verifyData = await verifyRes.json();
            if (verifyData.success) {
              alert("Payment Successful! Order Placed.");
              window.location.href = "/";
            } else {
              alert("Payment Verification Failed!");
            }
          },
          "prefill": {
            "name": "Customer Name",
            "email": "customer@example.com",
            "contact": "9999999999"
          },
          "theme": {
            "color": "#000000" // Customizes popup accent color
          }
        };

        // Step 4: Open Razorpay Modal
        const rzp1 = new Razorpay(options);
        
        rzp1.on('payment.failed', function (response){
          alert("Payment Failed: " + response.error.description);
        });

        rzp1.open();

      } catch (err) {
        console.error("Payment error:", err);
      }
    };
  </script>
</body>
</html>