<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart - ShopHigh</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-black font-sans antialiased flex flex-col min-h-screen">

    <!-- Header -->
    <header class="flex justify-between items-center px-8 py-5 border-b border-black bg-white">
        <div class="text-2xl font-black tracking-wider uppercase">
            <a href="/">ShopHigh</a>
        </div>
        <div>
            <a href="/" class="px-4 py-2 border border-black text-black hover:bg-black hover:text-white transition uppercase text-sm font-semibold">Home</a>
        </div>
    </header>

    <% if (typeof user !== 'undefined' && user !== null) { %>
        <!-- Main Content -->
        <main class="flex-grow max-w-4xl mx-auto px-6 py-10 w-full">
            <h1 class="text-3xl font-black mb-8 uppercase tracking-tight text-center">Your Cart</h1>

            <div id="cart-container" class="space-y-4">
                <p class="text-center text-gray-500 py-10">Loading your cart...</p>
            </div>

            <!-- Total and Checkout Section -->
            <div id="cart-summary" class="mt-8 border border-black p-6 bg-white hidden flex justify-between items-center shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
                <div>
                    <p class="text-xs font-bold uppercase text-gray-500">Total Amount</p>
                    <span id="total-price" class="text-2xl font-black">₹0</span>
                </div>
                <button id="place-order-btn" class="px-8 py-3 bg-black text-white font-bold uppercase text-sm hover:bg-gray-800 transition">
                    Place Order
                </button>
            </div>
        </main>

        <!-- Footer -->
        <footer class="text-center py-6 border-t border-black text-sm uppercase font-semibold bg-white mt-auto">
            &copy; 2026 ShopHigh. All Rights Reserved.
        </footer>

        <!-- Cart Logic Script -->
        <script>
            async function fetchCartItems() {
                const cart = JSON.parse(localStorage.getItem("cart")) || [];
                const container = document.getElementById('cart-container');
                const summarySection = document.getElementById('cart-summary');
                const totalPriceEl = document.getElementById('total-price');

                if (cart.length === 0) {
                    container.innerHTML = '<p class="text-center text-gray-500 py-10">Your cart is empty.</p>';
                    summarySection.classList.add('hidden');
                    return;
                }

                const itemIds = cart.map(item => item.itemId);

                try {
                    const response = await fetch('http://localhost:3000/cart-items', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ itemIds })
                    });

                    const data = await response.json();

                    if (data.success && data.products.length > 0) {
                        let html = '<div class="divide-y divide-black border border-black bg-white">';
                        let grandTotal = 0;
                        
                        data.products.forEach(product => {
                            const cartItem = cart.find(c => c.itemId === product._id.toString());
                            const quantity = cartItem ? cartItem.quantity : 1;
                            const itemTotal = product.price * quantity;
                            grandTotal += itemTotal;

                            html += `
                                <div class="p-4 flex items-center justify-between bg-white" data-id="${product._id}">
                                    <div class="flex items-center space-x-4">
                                        <img src="${product.image}" alt="${product.name}" class="w-16 h-16 object-cover border border-black">
                                        <div>
                                            <h2 class="font-bold text-lg">${product.name}</h2>
                                            <p class="text-gray-600 text-sm">₹${product.price} each</p>
                                            
                                            <!-- Quantity Controls -->
                                            <div class="flex items-center space-x-3 mt-2">
                                                <button onclick="updateQty('${product._id}', -1)" class="w-7 h-7 border border-black font-bold flex items-center justify-center hover:bg-black hover:text-white transition">-</button>
                                                <span class="text-sm font-bold">${quantity}</span>
                                                <button onclick="updateQty('${product._id}', 1)" class="w-7 h-7 border border-black font-bold flex items-center justify-center hover:bg-black hover:text-white transition">+</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <span class="font-extrabold text-lg block mb-1">₹${itemTotal}</span>
                                        <button onclick="removeItem('${product._id}')" class="text-xs uppercase font-bold text-red-600 hover:underline">Remove</button>
                                    </div>
                                </div>
                            `;
                        });

                        html += '</div>';
                        container.innerHTML = html;
                        totalPriceEl.innerText = `₹${grandTotal}`;
                        summarySection.classList.remove('hidden');
                    } else {
                        container.innerHTML = '<p class="text-center text-gray-500 py-10">Your cart is empty.</p>';
                        summarySection.classList.add('hidden');
                    }
                } catch (err) {
                    console.error("Error fetching cart:", err);
                    container.innerHTML = '<p class="text-center text-red-500 py-10">Failed to load cart items.</p>';
                }
            }

            // Quantity increase/decrease function
            function updateQty(itemId, change) {
                let cart = JSON.parse(localStorage.getItem("cart")) || [];
                const item = cart.find(c => c.itemId === itemId);

                if (item) {
                    item.quantity += change;
                    if (item.quantity <= 0) {
                        cart = cart.filter(c => c.itemId !== itemId);
                    }
                }

                localStorage.setItem("cart", JSON.stringify(cart));
                fetchCartItems(); // Re-render cart
            }

            // Remove single item function
            function removeItem(itemId) {
                let cart = JSON.parse(localStorage.getItem("cart")) || [];
                cart = cart.filter(c => c.itemId !== itemId);
                localStorage.setItem("cart", JSON.stringify(cart));
                fetchCartItems(); // Re-render cart
            }

            document.addEventListener('click', (e) => {
                if (e.target && e.target.id === 'place-order-btn') {
                    alert("Order placed successfully!");
                    
                    // localStorage.removeItem("cart");
                    window.location.href = "/placeOrder";
                }
            });

            fetchCartItems();
        </script>
    <% } else { %>
        <div class="flex-grow flex items-center justify-center">
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-gray-800 text-center py-8 uppercase">
                Please <a href="/login" class="text-black underline hover:bg-black hover:text-white px-2 py-1 transition">login</a> to see cart items
            </h2>
        </div>
    <% } %>
</body>
</html>