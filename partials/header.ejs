<div class="flex items-center gap-4">
    <% if (user) { %>
        <!-- Jab user logged-in hoga -->
        <span class="font-bold text-gray-800">👤 <%= user.username %></span>
        <a href="/logout" class="bg-red-500 text-white px-4 py-2 rounded-md hover:bg-red-600 transition">Logout</a>
    <% } else { %>
        <!-- Jab user logged-out hoga -->
        <a href="/login" class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 transition">Login</a>
        <a href="/signup" class="bg-gray-800 text-white px-4 py-2 rounded-md hover:bg-gray-900 transition">Signup</a>
    <% } %>
</div>


<header class="flex justify-between items-center px-8 py-5 border-b border-black bg-white">
    <div class="text-2xl font-black tracking-wider uppercase">
        <a href="/">ShopHigh</a>
    </div>
    <div class="flex items-center space-x-4">
        <!-- Cart Button -->
        <a href="/cart" class="px-4 py-2 border border-black text-black hover:bg-black hover:text-white transition uppercase text-sm font-semibold flex items-center gap-1">
             Cart
        </a>

        <!-- Auth buttons (Login/Signup) will show only if showAuthButtons is true or undefined -->
        <% if (typeof showAuthButtons === 'undefined' || showAuthButtons) { %>
            <a href="/login" class="px-4 py-2 border border-black text-black hover:bg-black hover:text-white transition uppercase text-sm font-semibold">Login</a>
            <a href="/signup" class="px-4 py-2 bg-black text-white hover:bg-gray-800 transition uppercase text-sm font-semibold">Signup</a>
        <% } %>
    </div>
</header>